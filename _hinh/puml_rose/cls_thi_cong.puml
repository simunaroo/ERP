class "ThiCongUI" as UI <<boundary>> {
  --
  +Kich nut 'Thi cong'()
  +Hien thi form lap giai doan()
  +Nhap giai doan, chon doi tho va kich nut 'Luu'()
  +Kich nut 'Bat dau' / 'Bao xong'()
  +Nhap so luong thuc te va kich nut 'Xac nhan nghiem thu'()
  +Kich nut 'Chot quyet toan'()
  +Hien thi don 'Hoan tat'()
}
