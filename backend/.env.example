PORT=4000
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=datn_erp
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_EXPIRES=8h
# Tro ly AI (tao key mien phi tai Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Model du phong khi model chinh qua tai (503) hoac timeout
GEMINI_MODEL_DU_PHONG=gemini-3.5-flash-lite

# Tai khoan cong ty nhan tien khach (tao QR thu tien tren chi tiet don)
CONG_TY_NGAN_HANG=Vietcombank
CONG_TY_STK=
CONG_TY_CHU_TK=CONG TY NST

# Duyet chi qua Telegram (khong bat buoc - khong co thi Admin duyet tren web)
TELEGRAM_BOT_TOKEN=
# Chat/nhom nhan tin de xuat chi
TELEGRAM_CHAT_ID_DUYET=
# Nhom Telegram gia lap NHA CUNG CAP: nhan don dat hang, bam "Cho xuat hang" / "Yeu cau coc" (khong bat buoc)
TELEGRAM_CHAT_ID_NCC=
# Username duoc phep bam Duyet, cach nhau dau phay (vd: giamdoc_nst,ketoantruong)
TELEGRAM_NGUOI_DUYET=
# polling (may ca nhan) | webhook (server co HTTPS public)
TELEGRAM_CHE_DO=polling
# Chuoi bi mat Telegram gui kem header khi goi webhook
TELEGRAM_WEBHOOK_SECRET=

# API day so tu dong (POST /api/nhap-so/tu-dong, header X-Api-Key). Sinh: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NHAP_SO_API_KEY=

# Webhook doi soat ngan hang (SePay goi POST /api/ngan-hang/webhook, header "Authorization: Apikey <khoa>"). De trong = tat.
NGAN_HANG_WEBHOOK_KEY=

# Xac thuc 2 lop: bat buoc cho Admin/Ke toan (false = tat, chi nen dung khi phat trien)
BAT_BUOC_2FA=true
# Khoa ma hoa du lieu bi mat trong CSDL (khoa TOTP). De trong = suy ra tu JWT_SECRET
MA_HOA_KEY=

# Sao luu tu dong (CSDL + anh). PG_BIN: thu muc chua pg_dump neu khong co trong PATH
SAO_LUU_TU_DONG=true
SAO_LUU_GIO=2
SAO_LUU_GIU=7
SAO_LUU_THU_MUC=
PG_BIN=
