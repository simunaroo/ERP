{
  "name": "datn-erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch-path=./src --watch-path=./.env src/server.js",
    "db:reset": "node scripts/db-reset.js",
    "db:reset:lon": "node scripts/db-reset.js --lon",
    "db:migrate": "node scripts/migrate.js",
    "db:seed:bo-sung": "node scripts/seed-bo-sung.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:bao-cao": "node --test --test-concurrency=1 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./test/bao-cao-md.mjs --test-reporter-destination=test/KET_QUA_KIEM_THU.md \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  }
}
